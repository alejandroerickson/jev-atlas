# ADIT — Brannock Geosystems' mock mineral-exploration ERM, public, synthetic data.
# Read by jev-atlas/run.sh, jev-atlas/inspect.sh and jev-atlas/chrome.sh (POSIX sh).
# Relative paths resolve against the repository root. No secrets here: the TypeSafe
# key stays in the harness copy's gitignored .env.
# The machine-specific values can be overridden from the environment without editing
# this file: JEV_CLONE, ADIT_CDP_URL, ADIT_BU_NAME, ADIT_CHROME_PROFILE,
# ADIT_PORT_WITHOUT, ADIT_PORT_WITH (and ADIT_RUN_DIR, read by the launchers).

APP_NAME="ADIT (mock exploration ERM)"

# Every run starts on the Portfolio home page.
START_URL="https://alejandroerickson.com/mockent/adit/#/portfolio"

# The atlas for the "with" condition.
ATLAS="jev-atlas/atlas/adit.json"

# Runs land under $RUN_DIR/with and $RUN_DIR/without, logs under $RUN_DIR/logs.
RUN_DIR="jev-atlas/runs"

# Pre-filled in the inspector; run.sh uses it when no goal is given.
DEFAULT_GOAL="tomasz answered yolanda's question on the mount aster overrun so go ahead and sign that off"

# Inspector ports, distinct from any other app's.
PORT_WITHOUT="${ADIT_PORT_WITHOUT:-8776}"
PORT_WITH="${ADIT_PORT_WITH:-8777}"

# The harness copy used for ADIT (built by jev-atlas/harness/bootstrap.sh).
JEV_CLONE="${JEV_CLONE:-$HERE/vendor/jev-ultrafast}"

# The browser: a Chrome with its own DevTools port and a throwaway
# profile (jev-atlas/chrome.sh starts it). ADIT is public, so no sign-in is needed.
# These are exported to the harness and win over the harness copy's .env.
BU_CDP_URL="${ADIT_CDP_URL:-http://127.0.0.1:9333}"
BU_NAME="${ADIT_BU_NAME:-adit}"
CHROME_PROFILE="${ADIT_CHROME_PROFILE:-$HOME/.cache/adit-chrome-profile}"

# The agent's tab size (harness default 1120x780).
JEV_VIEWPORT=1700x900
